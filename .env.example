# REGALUX AI — Synthetic User Research Intelligence
# Environment Configuration Template

# Server & Security
SECRET_KEY=regalux-royal-champagne-emerald-secret-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (MySQL recommended in production; SQLite auto-fallback locally)
# For MySQL: mysql+pymysql://<user>:<password>@localhost:3306/regalux_db
DATABASE_URL=sqlite:///./regalux.db

# Groq LLM Configuration
# Optional: if provided, live LLM generation is enabled; if empty, high-fidelity deterministic simulation is used
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Demo Mode (forces deterministic seeded responses when True)
DEMO_MODE=false
